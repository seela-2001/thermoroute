# ============================================================
# API Keys
# ============================================================

# FortyGuard API Configuration (optional - mock data works without)
# Get your key from FortyGuard
FORTYGUARD_API_KEY=your_fortyguard_api_key_here

# OpenRouter API Configuration (required for AI explanations)
# Get your key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-your-openrouter-api-key-here


# ============================================================
# FortyGuard Configuration
# ============================================================

# Base URL for FortyGuard API
FORTYGUARD_BASE_URL=https://api.fortyguard.com/v1

# Request timeout in seconds
FORTYGUARD_TIMEOUT=100


# ============================================================
# OpenRouter Configuration
# ============================================================

# Preferred model (default: google/gemma-2-9b-it:free)
# Free options: google/gemma-2-9b-it:free, meta-llama/llama-3-8b-instruct:free
OPENROUTER_MODEL=google/gemma-2-9b-it:free

# Temperature 0.0 - 1.0 (lower = more deterministic)
OPENROUTER_TEMPERATURE=0.3

# Maximum tokens in response
OPENROUTER_MAX_TOKENS=1000

# Request timeout in seconds
OPENROUTER_TIMEOUT=30

# Maximum retry attempts
OPENROUTER_MAX_RETRIES=3

# Retry delay multiplier
OPENROUTER_RETRY_AFTER=30

# Referer header for OpenRouter
OPENROUTER_REFERER=https://github.com/heatops

# App name for OpenRouter
OPENROUTER_APP_NAME=HeatOps AI Layer


# ============================================================
# Risk Weights (must sum to 100)
# ============================================================

RISK_WEIGHT_TEMPERATURE=30.0
RISK_WEIGHT_HEAT_INDEX=35.0
RISK_WEIGHT_HUMIDITY=15.0
RISK_WEIGHT_AQI=20.0


# ============================================================
# Optimization Weights (must sum to 100)
# ============================================================

OPTIM_WEIGHT_DISTANCE=20.0
OPTIM_WEIGHT_DURATION=20.0
OPTIM_WEIGHT_HEAT_RISK=40.0
OPTIM_WEIGHT_ENVIRONMENTAL=20.0


# ============================================================
# Risk Thresholds
# ============================================================

THRESHOLD_EXTREME=80
THRESHOLD_VERY_HIGH=60
THRESHOLD_HIGH=40
THRESHOLD_MODERATE=20


# ============================================================
# Normalization Ranges
# ============================================================

NORM_MAX_TEMPERATURE=50.0
NORM_MAX_HEAT_INDEX=55.0
NORM_MAX_AQI=200.0
NORM_MAX_DISTANCE=50.0
NORM_MAX_DURATION=120.0
NORM_HUMIDITY_OPTIMAL=50.0